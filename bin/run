#!/bin/sh
# Select the correct pakka-core binary for current OS/arch.
# Invoked by hooks via: ${CLAUDE_PLUGIN_ROOT}/bin/run <subcommand> [args]

# Kill-switch (issue #13): PAKKA_DISABLED=1 disables every pakka hook routed
# through this wrapper — exit 0 immediately, emit nothing, log nothing. Used
# by `pakka-core bench` to run the raw arm of the A/B benchmark in the same
# Claude Code session config with zero pakka injection.
if [ "${PAKKA_DISABLED:-}" = "1" ]; then
  exit 0
fi

set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
OS="$(uname -s | tr 'A-Z' 'a-z')"
ARCH="$(uname -m)"
case "$ARCH" in
  x86_64)  ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
esac

BIN="${DIR}/pakka-core-${OS}-${ARCH}"
if [ ! -x "$BIN" ]; then
  echo "pakka: no binary for ${OS}-${ARCH} at ${BIN}" >&2
  exit 1
fi

# Trace-log every hook invocation to ~/.pakka/debug.log.
# Rotate when the log exceeds 2 MB so it can't grow without bound (it was
# observed at 6+ MB / 128k lines). `wc -c <file` is an fstat-cheap size read;
# rotation keeps the last 1000 lines so recent traces survive.
LOG_DIR="${HOME}/.pakka"
LOG_FILE="${LOG_DIR}/debug.log"
mkdir -p "$LOG_DIR" 2>/dev/null
if [ -f "$LOG_FILE" ]; then
  SZ=$(wc -c < "$LOG_FILE" 2>/dev/null || echo 0)
  if [ "${SZ:-0}" -gt 2097152 ]; then
    tail -n 1000 "$LOG_FILE" > "${LOG_FILE}.tmp" 2>/dev/null && mv "${LOG_FILE}.tmp" "$LOG_FILE" 2>/dev/null
  fi
fi
printf '%s pid=%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$$" "$*" >> "$LOG_FILE" 2>/dev/null

exec "$BIN" "$@"
