# Binaries — release artifacts (bin/pakka-core-<os>-<arch>) ARE committed at release time.
# These patterns cover locally-built binaries and IDE artifacts only.
/bin/pakka-core
/bin/pakka-core.exe
/pakka-core

# Auto-compress backups (local-only, not committed)
*.original.md

# Go build artifacts
*.test
*.out
*.prof
coverage.*

# Local Pakka state (per-user, never committed)
.pakka/
.claude/settings.local.json

# bungu local index/scratch under docs/specs (per-user, not committed).
# Also keeps `make release` clean-tree gate + Go vcs stamping from tripping on it.
docs/specs/.bungu/

# CI release-asset staging dir (make release RELEASE_DIR=dist). Never committed;
# in-tree release binaries live in bin/ instead.
/dist/

# Benchmark results are committed deliberately as provenance artifacts
# (issue #13) — benchmarks/results/ is intentionally NOT ignored.

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.tmp
